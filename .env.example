# Переменные окружения проекта.

# --- ASR / пропуск «ожидания» по имени файла ---
# Хвост `..._MM-SS.ext` (минуты-секунды ожидания) всегда применяется как обрезка до распознавания.
# Отключить только если нужно: CALLQA_DISABLE_FILENAME_SKIP=1
# Крайний случай: без VAD Silero (дольше, но ничего не вырезается до Whisper): CALLQA_ASR_NO_VAD=1
# Pre-roll перед точкой ожидания (сек): чуть аудио до разреза — стабильнее VAD и первое окно Whisper. 0 = выкл.
# CALLQA_ASR_PRE_ROLL_SECONDS=0.25

# Таймкоды по словам в Whisper: по умолчанию вкл. только для ideal_ru (Максимум); для medium_ru и ultima_ru — выкл.
# Включить для Ultima (чуть медленнее, но точнее разбиение по паузам): CALLQA_ASR_WORD_TIMESTAMPS=1
# CALLQA_ASR_WORD_TIMESTAMPS=0

# Режим Ultima (профиль ultima_ru): репозиторий faster-whisper / CTranslate2 на Hugging Face.
# По умолчанию: bzikst/faster-whisper-large-v3-russian (fine-tuned whisper-large-v3-russian).
# CALLQA_WHISPER_MODEL_ULTIMA=bzikst/faster-whisper-large-v3-russian

# HF_HUB_OFFLINE=1 отключает загрузку с Hugging Face. Библиотека hub кэширует флаг при импорте;
# приложение при загрузке Whisper патчит его обратно (см. hf_hub_sync.force_huggingface_hub_online).
# Если всё же ошибка — проверьте TRANSFORMERS_OFFLINE и сеть/VPN.
# HF_HUB_OFFLINE=0

# Пароль входа в «Админ-панель» Streamlit (ключи Yandex + ссылка на Google Таблицу).
# Без этой переменной админ-панель будет отключена.
# ADMIN_PANEL_PASSWORD=...

# --- Google Sheets (экспорт строки после анализа) ---
# JSON-ключ сервисного аккаунта Google Cloud; таблицу расшарить на email из ключа (редактор).
# GOOGLE_SHEETS_CREDENTIALS_JSON=/absolute/path/to/service-account.json
# или относительно папки проекта: keygoogle.json
# Обязательный ID или ссылка на таблицу:
# GOOGLE_SHEETS_SPREADSHEET_ID=ваш_google_sheet_id
# Имя листа, если не первый:
# GOOGLE_SHEETS_WORKSHEET=Лист1
# Первая строка — заголовки (№, Дата, Имя оператора, Номер заявителя, Ожидание, Общая оценка, Полная оценка): true|false
# GOOGLE_SHEETS_HAS_HEADER=true
# Отключить экспорт: GOOGLE_SHEETS_DISABLE=1

# --- LLM пост-редактор ---
# По умолчанию в Streamlit — встроенная модель (Hugging Face), без Ollama. Другой чекпойнт:
# LLM_EMBEDDED_MODEL_ID=deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B
#
# Внешний OpenAI-compatible API (Ollama, LM Studio и т.д.):
# LLM_POST_EDIT_BASE_URL=http://127.0.0.1:11434/v1
# LLM_POST_EDIT_MODEL=llama3.2
# LLM_POST_EDIT_TIMEOUT_SECONDS=180
# LLM_POST_EDIT_API_KEY=

# --- Облачный режим оценки (Yandex AI Studio) ---
# Как получить:
#   1. console.yandex.cloud → AI Studio → «Создать ключ API» (scope: yc.ai.languageModels.execute)
#   2. Folder ID виден в выпадающем списке папок в шапке консоли
# YANDEX_API_KEY=AQVNw...
# YANDEX_FOLDER_ID=b1g...
# По умолчанию в коде — yandexgpt-lite (тот же API-ключ). Примеры:
# YANDEX_CLOUD_MODEL=yandexgpt-lite
# YANDEX_CLOUD_MODEL=yandexgpt/latest
# YANDEX_CLOUD_TIMEOUT_SECONDS=60
